{
  "name": "oauth-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "setup:local": "./scripts/setup-local-dev.sh",
    "dev": "pnpm --filter @oauth-server/frontend dev",
    "backend:build": "pnpm --filter @oauth-server/backend build",
    "backend:deploy": "./scripts/watch-backend.sh --once",
    "backend:watch": "./scripts/watch-backend.sh",
    "admin:create": "./scripts/create-admin-user.sh",
    "lint": "eslint '**/*.{js,jsx,ts,tsx}'",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx}'",
    "typecheck": "pnpm -r --if-present run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.tf": [
      "terraform fmt"
    ],
    "*.yaml": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
